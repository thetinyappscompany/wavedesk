# wa-gateway — copy to .env for local runs (never commit .env)
WA_GATEWAY_HOST=0.0.0.0
WA_GATEWAY_PORT=8081
LOG_LEVEL=info

# Frappe <-> gateway internal auth (required outside dev)
WA_GATEWAY_INTERNAL_SECRET=

# Redis (session hot state + wa:events stream) — used from epic 0.6
REDIS_URL=redis://localhost:6379

# S3-compatible storage for encrypted session snapshots — used from epic 0.6
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wavedesk-sessions
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AES-256-GCM key (32 bytes, base64) for session snapshot encryption — epic 0.6
SESSION_SNAPSHOT_KEY=
