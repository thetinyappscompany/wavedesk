# wa-gateway — copy to .env for local runs (never commit .env)
WA_GATEWAY_HOST=0.0.0.0
WA_GATEWAY_PORT=8081
LOG_LEVEL=info

# Frappe <-> gateway internal auth (required outside dev)
WA_GATEWAY_INTERNAL_SECRET=

# Redis (session hot state + wa:events stream)
REDIS_URL=redis://localhost:6379

# S3-compatible storage for encrypted session snapshots (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wavedesk-sessions
S3_ACCESS_KEY=devminio
S3_SECRET_KEY=devminio123

# AES-256-GCM key for session snapshots (base64, 32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SNAPSHOT_KEY=

# Snapshot cadence (default 5 min per master doc §2.2)
SNAPSHOT_INTERVAL_MS=300000
